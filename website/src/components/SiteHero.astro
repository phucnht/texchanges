---
import { ui, localeFrom, pathFor } from '../i18n/ui';

const locale = localeFrom(Astro.url);
const t = ui[locale];
---

<section class="tx-hero">
  <p class="tx-eyebrow">{t.heroEyebrow}</p>
  <h1 class="tx-hero__title">Texchanges</h1>
  <p class="tx-hero__subtitle">{t.heroSubtitle}</p>
  <p class="tx-hero__tagline">{t.heroTagline}</p>

  <div class="tx-hero__actions">
    <a class="tx-btn tx-btn--primary" href={pathFor(locale, '/getting-started/quick-start/')}>{t.ctaStart}</a>
    <a class="tx-btn" href={pathFor(locale, '/reference/cheatsheet/')}>{t.ctaCheatsheet}</a>
    <a class="tx-btn tx-btn--quiet" href="https://github.com/phucnht/texchanges">GitHub</a>
  </div>
</section>
