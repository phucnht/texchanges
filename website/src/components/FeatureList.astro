---
import { ui, localeFrom } from '../i18n/ui';

const t = ui[localeFrom(Astro.url)];

const features = [
  { title: t.f1, body: t.f1b },
  { title: t.f2, body: t.f2b },
  { title: t.f3, body: t.f3b },
  { title: t.f4, body: t.f4b },
  { title: t.f5, body: t.f5b },
  { title: t.f6, body: t.f6b }
];
---

<section class="tx-features" aria-labelledby="tx-features-title">
  <p class="tx-eyebrow" id="tx-features-title">{t.featuresEyebrow}</p>

  <ul class="tx-features__list">
    {features.map((feature) => (
      <li class="tx-feature">
        <h3 class="tx-feature__title"><span class="tx-feature__marker" aria-hidden="true">\item</span> {feature.title}</h3>
        <p class="tx-feature__body">{feature.body}</p>
      </li>
    ))}
  </ul>
</section>
