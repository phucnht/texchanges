        {sl}{\textsl{#2}}{em}{\emph{#2}}
      }{#2}
  }
\cs_new:Npn \tx_added_markup:n #1 {\tx_style:Vn \g_tx_added_style_tl {#1}}
\cs_new:Npn \tx_deleted_markup:n #1 {\tx_style:Vn \g_tx_deleted_style_tl {#1}}
\cs_new:Npn \tx_highlight_markup:n #1
